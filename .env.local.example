# Machine-local development settings. Copy to `.env.local` and edit the paths
# to match your own checkouts:
#
#     cp .env.local.example .env.local
#
# `.env.local` is covered by the repo's `*.local` ignore rule and must stay
# uncommitted — these are paths on one developer's machine, not project
# settings. This example file deliberately ships placeholders rather than
# anyone's real layout.
#
# Read only by debug builds (`npm run tauri dev`, `cargo run`), from the first
# `.env.local` found walking up from the working directory. A variable already
# set in your shell always wins, so a one-off override still works:
#
#     TYPIQL_MONOCOQUE_DEV_COMMAND=/other/build/monocoque npm run tauri dev
#
# Only TYPIQL_* and RUST_* keys are read; anything else is logged and skipped.
# See src-tauri/src/dev_env.rs, and src-tauri/src/service_commands.rs for why
# these are environment variables rather than app settings.

# Companion services. A debug build REFUSES to start a service whose dev
# command is unset rather than falling back to the installed binary, so
# leaving one of these blank means that service simply won't run.
TYPIQL_SIMD_DEV_COMMAND=/path/to/monocoque/src/monocoque/simulatorapi/simapi/build/simd/simd
TYPIQL_MONOCOQUE_DEV_COMMAND="/path/to/monocoque/build/monocoque play"
TYPIQL_HUENICORN_DEV_COMMAND=/path/to/huenicorn/build/huenicorn

# Prefix used to run Assetto Corsa outside this container/sandbox during a
# 360° capture. `distrobox-host-exec` on a distrobox setup; unset when the app
# already runs on the host with direct GPU access.
TYPIQL_CAPTURE_HOST_EXEC=distrobox-host-exec

# Optional.
#RUST_LOG=info
#RUST_BACKTRACE=1
