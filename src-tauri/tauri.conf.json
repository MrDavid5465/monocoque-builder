{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typiql",
  "version": "0.4.0",
  "identifier": "com.telemetryadmin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Telemetry Admin",
        "width": 1280,
        "height": 720,
        "devtools": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/typiql/dist": "../dist"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/typiql/dist": "../dist"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/typiql/dist": "../dist"
        }
      }
    }
  }
}
