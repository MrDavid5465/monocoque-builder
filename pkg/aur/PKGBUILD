# Maintainer: David Scott <david@davidallanscott.ca>
#
# "-bin" package wrapping the official .deb produced by this repo's own
# GitHub Release (tauri-action's build job) — the standard AUR pattern for
# packages that wrap an upstream project's own official prebuilt artifact
# rather than rebuilding from source on the user's machine.
#
# Package name is monocoque-builder, matching the GitHub repo, the installed
# binary and the Flatpak. It was briefly telemetry-admin, and before that the
# binary was named typiql after the library the app is built on rather than
# after the app itself; replaces/conflicts below carry anyone on the old
# package across without a manual uninstall.
#
# Release asset naming/tag format confirmed against a real GitHub Release
# (telemetry-admin-v0.1.1): release-please tags as
# {package-name}-v{version}, and tauri-action's default .deb name is
# `<productName>_<version>_<arch>.deb` (productName="monocoque-builder" per
# src-tauri/tauri.conf.json). sha256sums is `SKIP` until a real checksum
# is filled in via `updpkgsums` before pushing to the real AUR — `SKIP` is
# fine for the CI validation build in .github/workflows/integration-test.yml,
# which only needs the package to build+install successfully, not to prove
# supply-chain integrity.

pkgname=monocoque-builder
pkgver=0.1.0
pkgrel=1
pkgdesc="Telemetry dashboard designer and recorder for sim racing rigs"
arch=('x86_64')
url="https://github.com/MrDavid5465/monocoque-builder"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
provides=('monocoque-builder')
replaces=('telemetry-admin')
conflicts=('telemetry-admin')
options=('!strip')
source=("https://github.com/MrDavid5465/monocoque-builder/releases/download/monocoque-builder-v${pkgver}/monocoque-builder_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  bsdtar -xOf "monocoque-builder_${pkgver}_amd64.deb" data.tar.* | bsdtar -xf - -C "$pkgdir"
}
